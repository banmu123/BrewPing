# Server port
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Heartbeat interval (ms) - client sends ping every N ms
HEARTBEAT_INTERVAL=30000

# Heartbeat timeout (ms) - disconnect if no ping received within N ms
HEARTBEAT_TIMEOUT=60000

# Auth mode: anonymous | apikey | token (future)
AUTH_MODE=anonymous
