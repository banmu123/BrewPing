# Server port
PORT=3000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Heartbeat interval (ms) - client sends ping every N ms
HEARTBEAT_INTERVAL=30000

# Heartbeat timeout (ms) - disconnect if no ping received within N ms
HEARTBEAT_TIMEOUT=60000

# Shared relay token. Setting it switches the server to `token` mode:
# every REST call and every WebSocket handshake must present the same value
# (Authorization: Bearer <token>, X-Relay-Token: <token>, or ?token=<token>).
# Leave it empty only for local development — the server then runs in
# `anonymous` mode and logs a warning at startup.
RELAY_TOKEN=

# Auth mode. Leave unset to derive it from RELAY_TOKEN (token when set,
# anonymous when not). Set explicitly only if you need to force one.
# AUTH_MODE=token
